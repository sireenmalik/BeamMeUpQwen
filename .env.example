# LLM substrate for the crowd-following rApp.
#   MODEL_PROVIDER=none      -> deterministic forecaster, no key, demo runs out of the box
#   MODEL_PROVIDER=openai    -> any OpenAI-compatible endpoint (NVIDIA Nemotron via NIM, Qwen, vLLM, Ollama)
#   MODEL_PROVIDER=anthropic -> Claude
MODEL_PROVIDER=openai

# Endpoint base URL. For NVIDIA Nemotron via NIM:
MODEL_ENDPOINT=http://127.0.0.1:8000/v1

# Model id. Nano is right-sized for single-radio follow.
# For ORCA parity use: nvidia/nvidia-nemotron-3-super-120b
MODEL_NAME=qwen-tuned

# API key for the chosen endpoint. For NIM, paste your NVIDIA key (same one ORCA uses).
MODEL_API_KEY=

# Server
PORT=3000
TICK_MS=2000
